---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { groupPostsByTag } from '../../utils/tags';

export async function getStaticPaths() {
  const allPosts = await getCollection('posts', ({ data }) => !data.draft);

  return groupPostsByTag(allPosts).map(({ slug, label, aliases, posts }) => ({
    params: { tag: slug },
    props: { tag: label, aliases, posts },
  }));
}

const { tag, aliases, posts } = Astro.props;
---

<Layout
  title={`#${tag}`}
  description={`标签「${tag}」下的所有文章，共 ${posts.length} 篇。`}
>
  <header class="mb-10 border-b border-surface-2 pb-8">
    <div class="mb-2 flex items-center gap-3">
      <a
        href="/tags/"
        class="text-sm text-text-muted transition hover:text-accent"
        aria-label="返回标签列表"
      >
        标签
      </a>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="text-text-muted/40"
        aria-hidden="true"
      >
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
      <span class="text-sm text-text-muted">{tag}</span>
    </div>

    <h1 class="mb-2 text-3xl font-bold tracking-tight text-text">
      <span class="font-mono text-accent">#</span>{tag}
    </h1>
    <p class="text-sm text-text-muted">
      共 <span class="font-medium text-text">{posts.length}</span> 篇文章
    </p>
  </header>

  {posts.length === 0 ? (
    <div
      class="flex flex-col items-center justify-center py-20 text-text-muted/60"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="40"
        height="40"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="mb-4 opacity-40"
      >
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
        <polyline points="14 2 14 8 20 8" />
        <line x1="16" y1="13" x2="8" y2="13" />
        <line x1="16" y1="17" x2="8" y2="17" />
        <polyline points="10 9 9 9 8 9" />
      </svg>
      <p class="text-sm">该标签下暂无文章。</p>
    </div>
  ) : (
    <ul class="space-y-1">
      {posts.map((post) => {
        const isoDate = post.data.dateCreated.toISOString();
        const otherTags = post.data.tags.filter((t) => !aliases.includes(t));

        return <li class="group">
          <a
            href={`/posts/${post.id}/`}
            class="flex items-baseline gap-4 rounded-md px-2 py-2.5 transition hover:bg-surface-1"
          >
            <time
              datetime={isoDate}
              data-utc={isoDate}
              class="w-28 shrink-0 font-mono text-xs text-text-muted/60 group-hover:text-text-muted"
            >
              <span class="date-display">{isoDate.slice(0, 10)}</span>
            </time>

            <span class="flex-1 text-sm text-text group-hover:text-accent">
              {post.data.title}
            </span>

            {otherTags.length > 0 && <span
              class="hidden shrink-0 items-center gap-1.5 sm:flex"
            >
              {otherTags.slice(0, 2).map((t) => <span
                class="rounded px-1.5 py-0.5 text-xs text-text-muted/60 ring-1 ring-surface-2"
              >
                {t}
              </span>)}
              {otherTags.length > 2 && <span class="text-xs text-text-muted/40">
                +{otherTags.length - 2}
              </span>}
            </span>}

            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="shrink-0 text-text-muted/40 transition group-hover:translate-x-0.5 group-hover:text-accent"
              aria-hidden="true"
            >
              <line x1="5" y1="12" x2="19" y2="12" />
              <polyline points="12 5 19 12 12 19" />
            </svg>
          </a>
        </li>;
      })}
    </ul>
  )}

  <div class="mt-10">
    <a
      href="/tags/"
      class="inline-flex items-center gap-2 text-sm text-text-muted transition hover:text-accent"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <line x1="19" y1="12" x2="5" y2="12"></line>
        <polyline points="12 19 5 12 12 5"></polyline>
      </svg>
      返回标签列表
    </a>
  </div>

  <script>
    // Hydrate dates to user's local timezone
    const dateElements = document.querySelectorAll('.date-display');
    const formatter = new Intl.DateTimeFormat(navigator.language, {
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
    });

    dateElements.forEach((el) => {
      const timeEl = el.closest('time');
      const utc = timeEl?.getAttribute('data-utc');
      if (utc) {
        const date = new Date(utc);
        el.textContent = formatter.format(date);
      }
    });
  </script></Layout>
